# Debian 13 (trixie) build container for the fork, used together with the unpacked .deb tree
# ($KPNS_DEPS, see add_pkg.sh / deps_list.txt). The compiler, headers and libraries come from
# $KPNS_DEPS; the image adds CMake 3.31, the shader tools upstream KiCad now needs at build time
# (glslangValidator, spirv-opt) and the runtime libraries that the unpacked tools and the link step
# load from /usr. Build it and run configure.sh / ninja inside, with the source, build and deps
# directories mounted at the same paths as on the host and your own uid:
#   docker build --network host -t kpns-build:trixie -f Dockerfile.trixie .
#   docker run --rm -u $(id -u):$(id -g) -v "$DIR:$DIR" -w "$DIR" kpns-build:trixie bash -c \
#     'source ai-pns/host/env.sh && ai-pns/host/configure.sh && ninja -C "$KPNS_BUILD"'
FROM debian:13-slim
RUN echo 'Acquire::Retries "10";' > /etc/apt/apt.conf.d/80retries && apt-get update \
 && apt-get install -y --no-install-recommends cmake python3 git ca-certificates gzip tar file \
    libc6-dev glslang-tools spirv-tools libasound2t64 \
    libgl1 libglx0 libglu1-mesa libegl1 libice6 libsm6 libx11-6 libx11-xcb1 libxau6 libxaw7 libxcomposite1 \
    libxcursor1 libxdmcp6 libxext6 libxfixes3 libxft2 libxi6 libxinerama1 libxmuu1 libxrandr2 libxrender1 \
    libxt6t64 libxtst6 libxdamage1 libxmu6 libassuan9 libcairo-gobject2 libcairo2 libdav1d7 libelf1t64 \
    libfontconfig1 libfreetype6 libgcrypt20 libgtk-3-0t64 libgdk-pixbuf-2.0-0 libglib2.0-0t64 libgpg-error0 \
    libharfbuzz0b libharfbuzz-subset0 libicu76 libjansson4 libjson-c5 libpango-1.0-0 libpangocairo-1.0-0 \
    libpangoft2-1.0-0 libpixman-1-0 libpng16-16t64 libunwind8 libxcb-shm0 libxcb1 libxkbcommon0 libxkbfile1 \
    liblerc4 libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64 libcloudproviders0 libdatrie1 libdbus-1-3 \
    libdeflate0 libepoxy0 libexpat1 libffi8 libfribidi0 libgnutls30t64 libgraphite2-3 libkrb5-3 \
    libgssapi-krb5-2 libk5crypto3 libkrb5support0 libldap2 liblzma5 libnghttp2-14 libnghttp3-9 libp11-kit0 \
    libsharpyuv0 libtasn1-6 libthai0 libtiff6 libjbig0 libwebp7 libjpeg62-turbo libzstd1 libbz2-1.0 \
    libbrotli1 libcurl4t64 libssl3t64 \
 && rm -rf /var/lib/apt/lists/*
