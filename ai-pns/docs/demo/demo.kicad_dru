(version 1)
(rule "track to pad/via"
	(condition "A.Type == 'Track' && (B.Type == 'Pad' || B.Type == 'Via')")
	(constraint clearance (min 0.2286mm)))

# The micro-USB connector's own pads are 0.20 mm apart (library footprint): allow it
(rule "J2 pad pitch"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('J2') && B.memberOfFootprint('J2')")
	(constraint clearance (min 0.19mm)))
